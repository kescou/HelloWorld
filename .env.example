# Vermögen – Konfiguration. Kopieren nach .env (macht scripts/setup.sh automatisch) und bei Bedarf anpassen.
# Umgebungsvariablen haben Vorrang vor dieser Datei (z. B. PORT=8080 DATABASE_URL=... scripts/start.sh).

# PostgreSQL (docker compose up -d db legt genau diesen Benutzer/diese Datenbank an)
DATABASE_URL=postgresql+psycopg://wealth:wealth@localhost:5432/wealth

# Ablage der hochgeladenen Originaldokumente (relativ = relativ zum Repo-Verzeichnis)
UPLOAD_DIR=./data/uploads

# Lokales Sprachmodell für den Dokument-Import (optional; ohne Ollama laufen nur die festen Parser)
OLLAMA_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen2.5:7b-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:7b

BASE_CURRENCY=EUR

# Marktdaten im Hintergrund aktualisieren (Kurse alle QUOTE_REFRESH_SECONDS, Mo–Fr 8–22 Uhr; Rest täglich/wöchentlich)
ENABLE_SCHEDULER=true
QUOTE_REFRESH_SECONDS=120

# Weitere Stellschrauben des Imports (Präfix INGEST_, siehe docs/INGESTION.md), z. B.:
# INGEST_LLM_TIMEOUT_SECONDS=180
# INGEST_MAX_UPLOAD_MB=40
